<?xml version="1.0" encoding="UTF-8"?>
<TEI xmlns="http://www.tei-c.org/ns/1.0"
  xmlns:sch="http://purl.oclc.org/dsdl/schematron">
  <teiHeader>
    <fileDesc>
      <titleStmt>
        <title>TEI Customization ODD for testing ODD chain pipeline setup</title>
        <author>ATOP Task Force</author>
      </titleStmt>
      <publicationStmt>
        <p>Published by TEI-C on their ATOP repository site.</p>
      </publicationStmt>
      <sourceDesc>
        <p>Born digital.</p>
      </sourceDesc>
    </fileDesc>
  </teiHeader>
  <text>
    <body>
      <p>This is a customization of an existing TEI customization, using schemaSpec/@source
        to point to its ancestor customization, which itself is a customization of p5subset.xml, 
        resulting in a three-stage build.</p>
      <schemaSpec ident="tei_cust_of_cust" prefix="tei_" source="../tei_customization/tei_customization_default_source.odd"
        ns="http://www.tei-c.org/ns/1.0" start="TEI">

        <classSpec ident="att.typed" type="atts" mode="change">
          <attList>
            <attDef ident="subtype" mode="delete"/>
          </attList>
        </classSpec>
	
      </schemaSpec>
    </body>
  </text>
</TEI>
