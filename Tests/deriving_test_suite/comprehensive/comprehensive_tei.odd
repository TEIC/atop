<?xml version="1.0" encoding="UTF-8"?>
<?xml-model href="http://www.tei-c.org/release/xml/tei/custom/schema/relaxng/tei_odds.rng" type="application/xml" schematypens="http://relaxng.org/ns/structure/1.0"?>
<?xml-model href="http://www.tei-c.org/release/xml/tei/custom/schema/relaxng/tei_odds.rng" type="application/xml"
	schematypens="http://purl.oclc.org/dsdl/schematron"?>
<TEI xmlns="http://www.tei-c.org/ns/1.0" xml:lang="en" 
   xmlns:test="http://www.tei-c.org/ns/atop/test_suite">
   <teiHeader>
      <fileDesc>
         <titleStmt>
            <title>Comprehensive assembled ODD for derivation against p5subset.xml</title>
            <author>ATOP team</author>
         </titleStmt>
         <publicationStmt>
            <p>part of ATOP test suite</p>
      </publicationStmt>
         <sourceDesc>
            <p>born digital</p>
         </sourceDesc>
      </fileDesc>
   </teiHeader>
   <text>
      <body>
         <head><!-- name of markup language being defined can be repeated here --></head>
         <p><!-- prose description of, and explanation of, markup language goes here;
              you can use any TEI constructs you like, including multiple paragarphs,
              tables, nested divisions, etc. Furthermore, <specGrp> elements may
              be used to include snippets of schema definitions, and <specList>
              can be used to include to insert a list of descriptions of elements
              and attributes. --></p>
         <schemaSpec ident="derivation_comprehensive" prefix="drcmp_">
            <desc>
               This ODD is intended to test every variety of customization and combination
               thereof that the derivation processing phase will have to deal with.
            </desc>
            <moduleRef key="tei"/>
            <!-- Test @include here. -->
            <moduleRef key="core" include="abbr add addrLine address author bibl choice corr date del desc emph 
                                           expan graphic head item l lb lg list listBibl mentioned milestone
                                           name note num orig p pb ptr q quote ref sic title"/>
            <!-- Test @except here. -->
            <moduleRef key="header" except="appInfo application authority biblFull cRefPattern calendar 
                                             calendarDesc  citeData citeStructure conversion correction 
                                             correspAction correspContext correspDesc creation distributor
                                             extent funder geoDecl handNote hyphenation idno interpretation 
                                             keywords langUsage language listChange normalization notesStmt
                                             principal projectDesc punctuation quotation refState refsDecl 
                                             revisionDesc samplingDecl scriptNote segmentation seriesStmt
                                             sponsor stdVals styleDefDecl tagUsage tagsDecl unitDecl unitDef
                                             xenoData"/>
            <!-- Include all of these. -->
            <moduleRef key="textstructure"/>
            <moduleRef key="linking"/>
            
            <!-- Delete some elements from textstructure. -->
            <elementSpec module="textstructure" ident="div1" mode="delete"/>
            <elementSpec module="textstructure" ident="div2" mode="delete"/>
            <elementSpec module="textstructure" ident="div3" mode="delete"/>
            <elementSpec module="textstructure" ident="div4" mode="delete"/>
            <elementSpec module="textstructure" ident="div5" mode="delete"/>
            <elementSpec module="textstructure" ident="div6" mode="delete"/>
            <elementSpec module="textstructure" ident="div7" mode="delete"/>
            
            <!-- Add a new element to an existing module (good idea? bad idea?). -->
            <!-- This tests:
                   - adding a new element with its own native attribute.
                   - making it a member of an attribute class.
                   - deleting an attribute inherited from a class.
                   - modifying an attribute inherited from a class.
                   - Adding an attribute in a new namespace.
            -->
            <elementSpec ident="specialDiv" mode="add">
               <gloss xml:lang="en">My special div</gloss>
               <desc xml:lang="en">It's very special indeed.</desc>
               <classes>
                  <memberOf key="att.typed"/>
               </classes>
               <content>
                  <!-- Only p elements. -->
                  <elementRef key="p" minOccurs="1" maxOccurs="unbounded"/>
               </content>
               <attList>
                  <!-- It brings one attribute of its own. -->
                  <attDef ident="howSpecial">
                     <gloss xml:lang="en">How special is this div?</gloss>
                     <datatype>
                        <dataRef key="teidata.certainty"/>
                     </datatype>
                  </attDef>
                  <!-- Modify the type attribute. -->
                  <attDef ident="type" mode="change">
                     <gloss xml:lang="en">The type of special division</gloss>
                     <valList mode="add">
                        <valItem ident="old">
                           <gloss xml:lang="en">An old special div</gloss>
                        </valItem>
                        <valItem ident="new">
                           <gloss xml:lang="en">A new special div</gloss>
                        </valItem>
                     </valList>
                  </attDef>
                  <!-- Remove the subtype attribute. -->
                  <attDef ident="subtype" mode="delete"/>
                  
                  <!-- Testing adding an attribute in another namespace, with 
                       the @ns declared. NOTE that ATOP will only allow this 
                       formulation as a way to do this; other than the special
                       case of the xml: prefix, no prefix may be used directly
                       in the attDef/@ident in ATOP.
                  -->
                  <attDef ident="name" mode="add" ns="http://www.tei-c.org/ns/atop/test_suite">
                     <gloss>Testing a prefix which is undefined.</gloss>
                     <datatype>
                        <dataRef key="tei.token"/>
                     </datatype>
                  </attDef>
               </attList>
            </elementSpec> 
            
            <elementSpec ident="div" mode="change" module="textstructure">
               <content>
                  <elementRef key="specialDiv" minOccurs="1" maxOccurs="unbounded"/>
               </content>
            </elementSpec>

            <classSpec type="atts" ident="att.datable" mode="change">
               <attList>
                  <!-- Add a new native attribute to an existing class. -->
                  <attDef ident="prehistoric" mode="add">
                     <gloss xml:lang="en">prehistoric and therefore not datable</gloss>
                     <desc xml:lang="en">cannot be dated according to any regular calendar because it predates any of them.</desc>
                     <datatype>
                        <!-- Use an XSD native datatype. -->
                        <dataRef name="boolean"/>
                     </datatype>
                  </attDef>
               </attList>
            </classSpec>
            
            <elementSpec ident="del" module="core" mode="change">
               <!-- Replace a gloss in one language. -->
               <gloss xml:lang="ja">除去</gloss><!-- Originally "削除" -->
               <!-- Add a new gloss in a new language. -->
               <gloss xml:lang="in">hapus</gloss>
               <!-- Replace a desc in one language (just adds "du texte" to the original). -->
               <desc xml:lang="fr">contient une lettre, un mot ou un passage du texte supprimé, marqué comme supprimé, sinon indiqué comme superflu ou erroné dans le texte par un auteur, un copiste, un annotateur ou un correcteur.</desc><!-- Originally "contient une lettre, un mot ou un passage supprimé, marqué comme supprimé, sinon indiqué comme superflu ou erroné dans le texte par un auteur, un copiste, un annotateur ou un correcteur." -->
               <!-- Add a new desc in a new language. -->
               <desc xml:lang="in">berisi huruf, kata, atau bagian teks yang dihapus, ditandai sebagai dihapus, atau dinyatakan sebagai berlebihan atau tidak perlu dalam teks salinan oleh penulis, juru tulis, atau pemberi anotasi atau korektor sebelumnya.</desc>
               
               <classes mode="change">
                  <!-- Add this element to a class of which it wasn't a member before. -->
                  <memberOf key="att.datable" mode="add"/>
                  <!-- Remove it from a model class that it was a member of. -->
                  <memberOf key="model.linePart" mode="delete"/>
                  <!-- Remove it from an attribute class that it was a member of. -->
                  <memberOf key="att.typed" mode="delete"/>
               </classes>
               <attList>
                  <!-- Add a new native attribute to an existing element. -->
                  <attDef ident="goodCall" mode="add">
                     <gloss xml:lang="en">Was this deletion a good idea?</gloss>
                     <desc>Allows the encoder to judge the value or accuracy of a deletion.</desc>
                     <datatype>
                        <dataRef key="tei.xTruthValue"/>
                     </datatype>
                  </attDef>
                  <!-- Delete an attribute added to a class from a member of that class.
                       Here we delete the @prehistoric attribute, added to att.datable above. -->
                  <attDef ident="prehistoric" mode="delete"/>
               </attList>
            </elementSpec>
            
            <!-- Other customization scenarios. -->
            <!-- 
             - Change the datatype of a native attribute on an existing element.
             - Modify an existing datatype (e.g. add "absolute" as new val for data.certainty)
             - Modify an existing macro used in content models.
             - Add a new macro and replace an existing element's content model with it.
             
            
            
            
            -->
            
         </schemaSpec>
      </body>
   </text>
</TEI>
